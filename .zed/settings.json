// Zed Settings
//
// Documentation:
// https://zed.dev/docs/configuring-zed
//
// To view Zed's default settings:
// Command Palette → zed: open default settings
{
  // ---------------------------------------------------------------------------
  // AI / Agent Configuration
  // ---------------------------------------------------------------------------

  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "deepagents": {
      "type": "registry",
    },
    "cline": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },

  "context_servers": {
    "Context7": {
      "settings": {},
    },
    "mcp-server-context7": {
      "enabled": false,
      "settings": {
        "context7_api_key": "ctx7sk-efd1a1bf-b4df-4170-886b-f5cddab15428",
      },
    },
  },

  "agent": {
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "o4-mini",
    },
  },

  "edit_predictions": {
    "provider": "copilot",
    // "enabled": true,
  },

  // ---------------------------------------------------------------------------
  // Theme / Appearance
  // ---------------------------------------------------------------------------

  "theme": "One Dark Pro",
  "icon_theme": "Warm Charmed Icons",

  "theme_overrides": {
    // "Aura Soft Dark": {
    //   "border": "#21202E",
    //   "border.variant": "#21202E",
    //   "title_bar.background": "#21202E",
    //   "panel.background": "#21202E",
    //   "panel.focused_border": "#4E466E",

    //   "editor.document_highlight.read_background": "#00000000",
    //   "editor.document_highlight.write_background": "#00000000",

    //   "players": [
    //     {
    //       "cursor": "#BD9DFF",
    //     },
    //   ],

    //   "syntax": {
    //     "comment": {
    //       "font_style": "italic",
    //     },
    //     "comment.doc": {
    //       "font_style": "italic",
    //     },
    //   },
    // },
    // "Everforest Dark Soft": {
    //   "border": "#333C43",
    //   "border.variant": "#333C43",
    //   "title_bar.background": "#333C43",
    //   "panel.background": "#333C43",
    //   "panel.focused_border": "#4E466E",

    //   "editor.document_highlight.read_background": "#00000000",
    //   "editor.document_highlight.write_background": "#00000000",

    //   "players": [
    //     {
    //       "cursor": "#BD9DFF",
    //     },
    //   ],

    //   "syntax": {
    //     "comment": {
    //       "font_style": "italic",
    //     },
    //     "comment.doc": {
    //       "font_style": "italic",
    //     },
    //   },
    // },
    "One Dark Pro": {
      "border": "#23272E",
      "border.variant": "#23272E",
      "title_bar.background": "#23272E",
      "panel.background": "#23272E",
      "panel.focused_border": "#4E466E",

      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",

      "players": [
        {
          "cursor": "#BD9DFF",
        },
      ],

      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },

  "ui_font_size": 16,

  "title_bar": {
    "show_onboarding_banner": false,
  },

  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },

  "scrollbar": {
    "show": "auto",
  },

  // ---------------------------------------------------------------------------
  // Panels / Layout
  // ---------------------------------------------------------------------------

  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "starts_open": false,
    "sticky_scroll": false,
    "auto_fold_dirs": false,
    "file_icons": true,
  },

  "outline_panel": {
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },

  "collaboration_panel": {
    "dock": "right",
  },

  "git_panel": {
    "dock": "right",
  },

  "file_finder": {
    "modal_max_width": "medium",
  },

  // ---------------------------------------------------------------------------
  // Tabs / Status Bar / Gutter
  // ---------------------------------------------------------------------------

  "tabs": {
    "git_status": true,
  },

  // "status_bar": {
  //   "show_cursor_position": true,
  //   "show_vim_mode": true,
  // },

  "gutter": {
    "min_line_number_digits": 0,
  },

  // ---------------------------------------------------------------------------
  // Editor Font
  // ---------------------------------------------------------------------------

  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  // "buffer_font_size": 18,
  // "buffer_line_height": "comfortable",
  // "buffer_font_features": {
  //   "calt": true,
  // },

  // "agent_buffer_font_size": 16,
  //
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 18,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },

  "agent_buffer_font_size": 16,

  // ---------------------------------------------------------------------------
  // Cursor / Vim Mode
  // ---------------------------------------------------------------------------

  "vim_mode": true,

  "vim": {
    "use_system_clipboard": "always",
  },

  "relative_line_numbers": "enabled",
  // "cursor_blink_mode": "terminal_consistent",
  "cursor_shape": "bar",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "scroll_sensitivity": 1.0,

  // ---------------------------------------------------------------------------
  // Formatting
  // ---------------------------------------------------------------------------

  "format_on_save": "on",
  "formatter": "prettier",

  "tab_size": 2,
  "hard_tabs": false,

  "remove_trailing_whitespace_on_save": true,
  // "ensure_newline_on_save": true,
  "use_autoclose": true,

  // ---------------------------------------------------------------------------
  // Visual Guides / Editor Helpers
  // ---------------------------------------------------------------------------

  "preferred_line_length": 80,
  "wrap_guides": [80, 120],
  "soft_wrap": "editor_width",
  "show_whitespaces": "selection",
  // "bracket_pair_colorization": true,

  "minimap": {
    // "enabled": true,
    "show": "auto",
    "max_width_columns": 50,
  },

  // ---------------------------------------------------------------------------
  // Terminal
  // ---------------------------------------------------------------------------

  // "terminal": {
  //   "font_family": "JetBrainsMono Nerd Font Mono",
  //   "font_size": 16,
  //   "line_height": "comfortable",
  //   "blinking_cursor": true,
  //   "dock": "bottom",
  //   "shell": {
  //     "program": "zsh",
  //   },
  //   "working_directory": "current_project_directory",
  // },
  //
  "terminal": {
    "font_family": "Iosevka Nerd Font",
    "font_size": 16,
    "line_height": "comfortable",
    // "blinking_cursor": true,
    "dock": "bottom",
    "shell": {
      "program": "zsh",
    },
    "working_directory": "current_project_directory",
  },

  // ---------------------------------------------------------------------------
  // Git / Telemetry
  // ---------------------------------------------------------------------------

  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // ---------------------------------------------------------------------------
  // Inlay Hints
  // ---------------------------------------------------------------------------

  "inlay_hints": {
    "enabled": false,
    "show_type_hints": false,
    "show_parameter_hints": false,
  },

  // ---------------------------------------------------------------------------
  // Language Server Configuration
  // ---------------------------------------------------------------------------

  "lsp": {
    "eslint": {
      "settings": {
        "nodePath": "./node_modules/eslint",
        "validate": [
          "javascript",
          "typescript",
          "typescriptreact",
          "javascriptreact",
        ],
        "run": "onType",
        "format": true,
        "codeActionOnSave": {
          "enable": true,
          "mode": "all",
        },
      },
    },

    "typescript-language-server": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "includeInlayParameterNameHints": "none",
            "includeInlayParameterNameHintsWhenArgumentMatchesName": false,
            "includeInlayFunctionParameterTypeHints": false,
            "includeInlayVariableTypeHints": false,
            "includeInlayPropertyDeclarationTypeHints": false,
            "includeInlayFunctionLikeReturnTypeHints": false,
            "includeInlayEnumMemberValueHints": false,
          },
        },
      },
    },

    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "validate": true,
          "lint": {
            "cssConflict": "warning",
            "invalidApply": "error",
            "invalidConfigPath": "error",
            "invalidScreen": "error",
            "invalidTailwindDirective": "error",
            "invalidVariant": "error",
            "recommendedVariantOrder": "warning",
          },
        },
      },
    },

    "vtsls": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
          },
        },
      },
    },
  },

  // ---------------------------------------------------------------------------
  // Language-Specific Settings
  // ---------------------------------------------------------------------------

  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },

    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },

    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },

    // "JSX": {
    //   "code_actions_on_format": {
    //     "source.fixAll.eslint": true,
    //   },
    // "Markdown": {
    //   "remove_trailing_whitespace_on_save": false,
    // },

    // "CSS": {
    //   "language_servers": ["tailwindcss-language-server", "eslint"],
    // },
  },

  // ---------------------------------------------------------------------------
  // File Scan Exclusions
  // ---------------------------------------------------------------------------

  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/.nx",
    "**/tools",
    "**/nginx",
    "**/.husky",

    "**/mfe-nmfe-svc",
    "**/pos-svc-cws",
    "**/pos-svc",
    "**/pcm-svc",
    "**/wadmin-svc",
    "**/wholesaler-svc",
    "**/ebill-svc-cws",
    "**/ebill-svc",

    "**/boost-e2e",
    "**/config-e2e",
    "**/ebill-e2e",
    "**/mycare-e2e",
    "**/pcm-e2e",
    "**/pos-e2e",
    "**/w-admin-e2e",
    "**/wholesaler-e2e",
  ],

  // ---------------------------------------------------------------------------
  // Custom Dictionary
  // ---------------------------------------------------------------------------

  "custom_words": [
    "EXOS",
    "Msal",
    "tanstack",
    "correlator",
    "exos",
    "msal",
    "reduxjs",
    "hookform",
    "nrwl",
    "nx",
    "nivo",
    "apexcharts",
    "jspdf",
    "tesseract",
    "mrz",
    "stylis",
  ],
}
