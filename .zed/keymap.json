// Zed Keymap
//
// Goal:
// Use VS Code-style shortcuts inside Zed editor.
//
// Docs:
// https://zed.dev/docs/key-bindings
//
// To view Zed default keymap:
// Command Palette → zed: open default keymap
[
  // ---------------------------------------------------------------------------
  // Global / Workspace
  // ---------------------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      // Toggle sidebar / left dock like VS Code Cmd+E
      "cmd-e": "workspace::ToggleLeftDock",

      // Focus project panel / explorer like VS Code Cmd+1
      "cmd-1": "project_panel::ToggleFocus",

      // Quick open / file finder like VS Code Ctrl+P
      "ctrl-p": "file_finder::Toggle",

      // Git / source control panel
      "cmd-g g": "workspace::ToggleRightDock",

      // Pane navigation like VS Code Vim navigation
      "cmd-h": "workspace::ActivatePaneLeft",
      "cmd-l": "workspace::ActivatePaneRight",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-j": "workspace::ActivatePaneDown",

      // Assistant / Copilot-like panel
      "alt-c": "assistant::ToggleFocus",

      // Inline AI edit, similar to VS Code Cmd+Alt+I
      "cmd-alt-i": "assistant::InlineAssist",
      "ctrl-enter": "assistant::InlineAssist",
    },
  },

  // ---------------------------------------------------------------------------
  // Project Panel / File Explorer
  // ---------------------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // Create new file
      "n": "project_panel::NewFile",

      // Create new folder
      "shift-n": "project_panel::NewDirectory",

      // Rename selected file/folder
      "r": "project_panel::Rename",

      // Delete selected file/folder
      "d": "project_panel::Delete",

      // Open selected file/folder
      "enter": "project_panel::Open",
      "space": "project_panel::Open",

      // Clipboard actions inside file explorer
      "cmd-c": "project_panel::Copy",
      "cmd-x": "project_panel::Cut",
      "cmd-v": "project_panel::Paste",
    },
  },

  // ---------------------------------------------------------------------------
  // Editor / General Editing
  // ---------------------------------------------------------------------------
  {
    "context": "Editor",
    "bindings": {
      // Standard editor shortcuts
      "cmd-a": "editor::SelectAll",
      "cmd-c": "editor::Copy",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",

      // Find
      "cmd-f": "buffer_search::Deploy",

      // Add selection to next match, like VS Code Ctrl+N
      "ctrl-n": "editor::SelectNext",

      // Inline AI assistant
      "ctrl-enter": "assistant::InlineAssist",
    },
  },

  // ---------------------------------------------------------------------------
  // Editor / Vim Normal Mode
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Switch tabs like your VS Code Vim setup
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",

      // Hover documentation
      "shift-k": "editor::Hover",

      // Go to definition
      "space d": "editor::GoToDefinition",

      // Find references
      "space r": "editor::FindAllReferences",

      // Find inside current file
      "cmd-f": "buffer_search::Deploy",

      // Add next selection
      "ctrl-n": "editor::SelectNext",

      // Cancel search / menu / current operation
      "escape": "editor::Cancel",
    },
  },

  // ---------------------------------------------------------------------------
  // Editor / Vim Visual Mode
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      // Switch tabs while visual mode is active
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",

      // Find
      "cmd-f": "buffer_search::Deploy",

      // Add next selection
      "ctrl-n": "editor::SelectNext",

      // Cancel current operation
      "escape": "editor::Cancel",
    },
  },

  // ---------------------------------------------------------------------------
  // Suggestions / IntelliSense Menu
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && menu_open",
    "bindings": {
      // Navigate suggestions with Cmd+J / Cmd+K
      "cmd-j": "menu::SelectNext",
      "cmd-k": "menu::SelectPrevious",
    },
  },

  // ---------------------------------------------------------------------------
  // Assistant / AI Shortcuts
  // ---------------------------------------------------------------------------
  {
    "context": "Editor",
    "bindings": {
      // VS Code Copilot-like shortcuts mapped to Zed assistant behavior
      "alt-c": "assistant::ToggleFocus",
      "cmd-alt-i": "assistant::InlineAssist",

      // These are closest Zed equivalents.
      // Zed may not have direct separate commands for explain/fix/docs/review
      // like VS Code Copilot Chat.
      "alt-e": "assistant::InlineAssist",
      "alt-f": "assistant::InlineAssist",
      "alt-d": "assistant::InlineAssist",
      "alt-r": "assistant::InlineAssist",
    },
  },

  // ---------------------------------------------------------------------------
  // Resolve Cmd+K Conflicts
  // ---------------------------------------------------------------------------
  // Zed uses Cmd+K as a command prefix by default.
  // These unbindings allow Cmd+K to work for pane/suggestion navigation.
  {
    "context": "Workspace",
    "bindings": {
      "cmd-k s": null,
      "cmd-k m": null,
      "cmd-k g": null,
      "cmd-k shift-s": null,
    },
  },
]
